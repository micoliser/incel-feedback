# App
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Public site URL (no trailing slash). Used in internal email admin links.
# Local: http://localhost:3000
# Production: https://your-feedback-domain.com
APP_BASE_URL=http://localhost:3000

# Postgres (company CapRover / local)
DB_NAME=incel_feedback_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional full URL override (required by Prisma; can be assembled from DB_*):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/incel_feedback_db


EMAIL_HOST=smtp-relay.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@inceltourism.com
EMAIL_SENDER_NAME=Incel Holidays and Tourism
# Real domain for SMTP EHLO (Google rejects Docker hostnames)
EMAIL_EHLO_DOMAIN=inceltourism.com
EMAIL_ENABLED=true
# Local: true (print to console). Production: false (actually send)
EMAIL_DEBUG=false
INTERNAL_NOTIFICATION_EMAILS=
